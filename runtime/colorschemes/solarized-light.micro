# Solarized Light — Herdr
color-link default "#657B83,#FDF6E3"
color-link comment "#93A1A1"
color-link constant "#6C71C4"
color-link constant.number "#CB4B16"
color-link constant.string "#859900"
color-link identifier "#268BD2"
color-link identifier.class "#6C71C4"
color-link identifier.var "#657B83"
color-link statement "#859900"
color-link symbol "#859900"
color-link symbol.brackets "#657B83"
color-link type "#2AA198"
color-link type.keyword "#859900"
color-link special "#DC322F"
color-link preproc "#CB4B16"
color-link underlined "#6C71C4"
color-link error "bold #DC322F"
color-link todo "bold #B58900"
color-link hlsearch "#FDF6E3,#B58900"
color-link diff-added "#859900"
color-link diff-modified "#CB4B16"
color-link diff-deleted "#DC322F"
color-link gutter-error "#DC322F"
color-link gutter-warning "#B58900"
color-link statusline "#EEE8D5,#657B83"
color-link tabbar "#EEE8D5,#657B83"
color-link indent-char "#EEE8D5"
color-link line-number "#93A1A1,#EEE8D5"
color-link current-line-number "#657B83,#EEE8D5"
color-link cursor-line "#EEE8D5,#657B83"
color-link color-column "#EEE8D5"
color-link divider "#93A1A1"
color-link match-brace "#FDF6E3,#6C71C4"
color-link tab-error "#DC322F"
color-link trailingws "#DC322F"
