# Kanagawa — Herdr
color-link default "#DCD7BA,#1F1F28"
color-link comment "#727169"
color-link constant "#957FB8"
color-link constant.number "#FFA066"
color-link constant.string "#98BB6C"
color-link identifier "#7E9CD8"
color-link identifier.class "#957FB8"
color-link identifier.var "#DCD7BA"
color-link statement "#957FB8"
color-link symbol "#957FB8"
color-link symbol.brackets "#DCD7BA"
color-link type "#7FB4CA"
color-link type.keyword "#957FB8"
color-link special "#E46876"
color-link preproc "#FFA066"
color-link underlined "#957FB8"
color-link error "bold #E46876"
color-link todo "bold #E6C384"
color-link hlsearch "#1F1F28,#E6C384"
color-link diff-added "#98BB6C"
color-link diff-modified "#FFA066"
color-link diff-deleted "#E46876"
color-link gutter-error "#E46876"
color-link gutter-warning "#E6C384"
