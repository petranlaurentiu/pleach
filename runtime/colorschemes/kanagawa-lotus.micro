color-link constant.number "#CC6D00"
color-link constant.string "#6F894E"
color-link identifier "#4D699B"
color-link identifier.class "#624C83"
color-link identifier.var "#545464"
color-link statement "#624C83"
color-link symbol "#624C83"
color-link symbol.brackets "#545464"
color-link type "#597B75"
color-link type.keyword "#624C83"
color-link special "#C84053"
color-link preproc "#CC6D00"
color-link underlined "#624C83"
color-link error "bold #C84053"
color-link todo "bold #77713F"
color-link hlsearch "#F2ECBC,#77713F"
color-link diff-added "#6F894E"
color-link diff-modified "#CC6D00"
color-link diff-deleted "#C84053"
