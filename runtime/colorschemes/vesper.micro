# Vesper — Herdr
color-link default "#FFFFFF,#101010"
color-link comment "#8B8B8B"
color-link constant "#FFC799"
color-link constant.number "#FFC799"
color-link constant.string "#99FFE4"
color-link identifier "#A0A0A0"
color-link identifier.class "#FFC799"
color-link identifier.var "#FFFFFF"
color-link statement "#FFC799"
color-link symbol "#FFC799"
color-link symbol.brackets "#FFFFFF"
color-link type "#99FFE4"
color-link type.keyword "#FFC799"
color-link special "#FFC799"
color-link preproc "#FFC799"
color-link underlined "#FFC799"
color-link error "bold #FF8080"
color-link todo "bold #FFC799"
color-link hlsearch "#101010,#FFC799"
color-link diff-added "#99FFE4"
color-link diff-modified "#FFC799"
color-link diff-deleted "#FF8080"
color-link gutter-error "#FF8080"
color-link gutter-warning "#FFC799"
color-link statusline "#0A0A0A,#FFFFFF"
color-link tabbar "#0A0A0A,#FFFFFF"
color-link indent-char "#2A2A2A"
color-link line-number "#8B8B8B,#0A0A0A"
color-link current-line-number "#FFFFFF,#0A0A0A"
color-link cursor-line "#1C1C1C,#FFFFFF"
color-link color-column "#1C1C1C"
color-link divider "#2A2A2A"
color-link match-brace "#101010,#FFC799"
color-link tab-error "#FF8080"
color-link trailingws "#FF8080"
