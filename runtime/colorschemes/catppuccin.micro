# Catppuccin Mocha — Herdr default
color-link default "#CDD6F4,#1E1E2E"
color-link comment "#6C7086"
color-link constant "#CBA6F7"
color-link constant.number "#FAB387"
color-link constant.string "#A6E3A1"
color-link identifier "#89B4FA"
color-link identifier.class "#CBA6F7"
color-link identifier.var "#CDD6F4"
color-link statement "#F5C2E7"
color-link symbol "#F5C2E7"
color-link symbol.brackets "#CDD6F4"
color-link type "#89DCEB"
color-link type.keyword "#CBA6F7"
color-link special "#F5C2E7"
color-link preproc "#FAB387"
color-link underlined "#F5C2E7"
color-link error "bold #F38BA8"
color-link todo "bold #F9E2AF"
color-link hlsearch "#1E1E2E,#F9E2AF"
color-link diff-added "#A6E3A1"
color-link diff-modified "#FAB387"
color-link diff-deleted "#F38BA8"
color-link gutter-error "#F38BA8"
color-link gutter-warning "#F9E2AF"
color-link statusline "#181825,#CDD6F4"
color-link tabbar "#181825,#CDD6F4"
color-link indent-char "#45475A"
color-link line-number "#6C7086,#181825"
color-link current-line-number "#CDD6F4,#181825"
color-link cursor-line "#313244,#CDD6F4"
color-link color-column "#313244"
color-link divider "#45475A"
color-link match-brace "#1E1E2E,#CBA6F7"
color-link tab-error "#F38BA8"
color-link trailingws "#F38BA8"
