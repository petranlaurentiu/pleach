# Gruvbox Light — Herdr
color-link default "#3C3836,#FBF1C7"
color-link comment "#928374"
color-link constant "#8F3F71"
color-link constant.number "#AF3A03"
color-link constant.string "#79740E"
color-link identifier "#076678"
color-link identifier.class "#8F3F71"
color-link identifier.var "#3C3836"
color-link statement "#9D0006"
color-link symbol "#9D0006"
color-link symbol.brackets "#3C3836"
color-link type "#427B58"
color-link type.keyword "#9D0006"
color-link special "#AF3A03"
color-link preproc "#B57614"
color-link underlined "#9D0006"
color-link error "bold #9D0006"
color-link todo "bold #B57614"
color-link hlsearch "#FBF1C7,#B57614"
color-link diff-added "#79740E"
color-link diff-modified "#AF3A03"
color-link diff-deleted "#9D0006"
color-link gutter-error "#9D0006"
color-link gutter-warning "#B57614"
color-link statusline "#EBDBB2,#3C3836"
color-link tabbar "#EBDBB2,#3C3836"
color-link indent-char "#D5C4A1"
color-link line-number "#928374,#EBDBB2"
color-link current-line-number "#3C3836,#EBDBB2"
color-link cursor-line "#EBDBB2,#3C3836"
color-link color-column "#EBDBB2"
color-link divider "#D5C4A1"
color-link match-brace "#FBF1C7,#8F3F71"
color-link tab-error "#9D0006"
color-link trailingws "#9D0006"
