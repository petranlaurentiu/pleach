# One Light — Herdr
color-link default "#383A42,#FAFAFA"
color-link comment "#A0A1A7"
color-link constant "#A626A4"
color-link constant.number "#986801"
color-link constant.string "#50A14F"
color-link identifier "#4078F2"
color-link identifier.class "#A626A4"
color-link identifier.var "#383A42"
color-link statement "#A626A4"
color-link symbol "#A626A4"
color-link symbol.brackets "#383A42"
color-link type "#0184BC"
color-link type.keyword "#A626A4"
color-link special "#E45649"
color-link preproc "#C18401"
color-link underlined "#A626A4"
color-link error "bold #E45649"
color-link todo "bold #C18401"
color-link hlsearch "#FAFAFA,#C18401"
color-link diff-added "#50A14F"
color-link diff-modified "#C18401"
color-link diff-deleted "#E45649"
color-link gutter-error "#E45649"
color-link gutter-warning "#C18401"
color-link statusline "#E5E5E6,#383A42"
color-link tabbar "#E5E5E6,#383A42"
color-link indent-char "#D0D0D1"
color-link line-number "#A0A1A7,#E5E5E6"
color-link current-line-number "#383A42,#E5E5E6"
color-link cursor-line "#F0F0F1,#383A42"
color-link color-column "#F0F0F1"
color-link divider "#D0D0D1"
color-link match-brace "#FAFAFA,#A626A4"
color-link tab-error "#E45649"
color-link trailingws "#E45649"
